	{ label: 'Formation', href: '#formation' },
	{ label: 'Experience', href: '#experiences' },
	{ label: 'Tools', href: '#skills' },
	{ label: 'Courses', href: '#courses' },
	{ label: 'Projects', href: '#projects' },
	{ label: 'Contact', href: '#contact' },
];

const toolGroups = [
	{ label: 'Languages', direction: 'forward', items: [{ name: 'HTML', mark: '</>', tone: 'orange' }, { name: 'CSS', mark: '#', tone: 'blue' }, { name: 'JavaScript', mark: 'JS', tone: 'yellow' }, { name: 'TypeScript', mark: 'TS', tone: 'blue' }] },
	{ label: 'Frameworks', direction: 'reverse', items: [{ name: 'React', mark: '⚛', tone: 'cyan' }, { name: 'Astro', mark: '✦', tone: 'purple' }, { name: 'Node', mark: 'N', tone: 'green' }, { name: 'Tailwind', mark: '~', tone: 'cyan' }] },
	{ label: 'Creative tools', direction: 'forward', items: [{ name: 'Figma', mark: 'F', tone: 'red' }, { name: 'Canva', mark: 'C', tone: 'blue' }, { name: 'Notion', mark: 'N', tone: 'black' }, { name: 'Procreate', mark: 'P', tone: 'pink' }] },
	{ label: 'Other skills', direction: 'reverse', items: [{ name: 'GitHub', mark: '◈', tone: 'black' }, { name: 'Motion', mark: '✧', tone: 'pink' }, { name: 'Branding', mark: 'B', tone: 'red' }, { name: 'Research', mark: '⌕', tone: 'green' }] },
];

const languages = [
	{ number: '01', name: 'Portuguese', level: 'NATIVE', fill: '100%' },
	{ number: '02', name: 'English', level: 'FLUENT', fill: '88%' },
	{ number: '03', name: 'Your language', level: 'ADD LEVEL', fill: '64%' },
	{ number: '04', name: 'Your language', level: 'ADD LEVEL', fill: '42%' },
];

const contactLinks = [
	{ label: 'LinkedIn', detail: 'LET\'S CONNECT', href: 'https://www.linkedin.com/in/your-handle', icon: 'in', tone: 'blue' },
	{ label: 'Instagram', detail: 'SEE THE PIXELS', href: 'https://www.instagram.com/your-handle', icon: 'ig', tone: 'pink' },
	{ label: 'Phone', detail: 'SAY HELLO', href: 'tel:+0000000000', icon: '☎', tone: 'green' },
	{ label: 'Email', detail: 'SEND A QUEST', href: 'mailto:hello@nina.design', icon: '@', tone: 'purple' },
];

const waveItems = [
	{ src: '/9.png', alt: 'Pixel sparkle', size: 'small', offset: -44, tilt: -8, scale: .72 },
	{ src: '/8.png', alt: 'Pixel tulip', size: 'large', offset: -25, tilt: 7, scale: .56, mobileHide: true },
	{ src: '/10.png', alt: 'Pixel strawberry', size: 'small', offset: 0, tilt: -5, scale: .62 },
	{ src: '/15.png', alt: 'Pixel heart', size: 'large', offset: 28, tilt: -4, scale: .58 },
	{ src: '/2.png', alt: 'Pixel bow', size: 'large', offset: 44, tilt: 4, scale: .4 },
	{ src: '/1.png', alt: 'Pixel laptop', size: 'large', offset: 25, tilt: -8, scale: .42 },
	{ src: '/6.png', alt: 'Pixel shimmer', size: 'small', offset: 4, tilt: 10, scale: .55 },
	{ src: '/8.png', alt: 'Pixel tulip', size: 'large', offset: -27, tilt: -7, scale: .6, mobileHide: true },
	{ src: '/10.png', alt: 'Pixel strawberry', size: 'small', offset: -44, tilt: 5, scale: .55 },
	{ src: '/15.png', alt: 'Pixel heart', size: 'small', offset: -24, tilt: 8, scale: .48 },
	{ src: '/2.png', alt: 'Pixel bow', size: 'large', offset: 5, tilt: -5, scale: .34 },
	{ src: '/1.png', alt: 'Pixel laptop', size: 'small', offset: 34, tilt: 6, scale: .42 },
	{ src: '/8.png', alt: 'Pixel tulip', size: 'small', offset: 46, tilt: -3, scale: .5 },
	{ src: '/10.png', alt: 'Pixel strawberry', size: 'large', offset: 23, tilt: 5, scale: .58, mobileHide: true },
	{ src: '/15.png', alt: 'Pixel heart', size: 'small', offset: -2, tilt: -8, scale: .43 },
	{ src: '/2.png', alt: 'Pixel bow', size: 'small', offset: -26, tilt: 6, scale: .38 },
];

const projects = [
	{ number: '01', title: 'Pink Pixel Studio', type: 'BRAND EXPERIENCE', text: 'A playful identity system made for digital products that want to feel unforgettable.', tags: ['Branding', 'UI Design'] },
	{ number: '02', title: 'Quest Board', type: 'PRODUCT DESIGN', text: 'A cozy productivity interface that turns tiny daily wins into a game worth playing.', tags: ['UX/UI', 'Prototyping'] },
	{ number: '03', title: 'Level Up Landing', type: 'FRONT-END BUILD', text: 'A responsive campaign page with motion, personality and a little bit of delightful chaos.', tags: ['Web Design', 'Creative Code'] },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="A playful portfolio for a creative designer and front-end developer." />
		<title>Nina // Player One</title>
	</head>
	<body>
		<div class="scanlines" aria-hidden="true"></div>
		<div class="page-shell">
			<header class="topbar">
				<a class="brand" href="#top" aria-label="Back to top">
					<span class="brand-mark"><span></span><span></span><span></span><span></span></span>
					<span>NINA<span class="brand-slash">//</span>PLAYER_01</span>
				</a>
				<button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false">
					<span class="menu-toggle-icon" aria-hidden="true">☰</span> MENU
				</button>
				<nav id="main-nav" aria-label="Main navigation">
					{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="status-pill" href="#contact"><span class="status-dot"></span> AVAILABLE FOR QUESTS</a>
			</header>

			<main id="top">
				<section class="hero section-grid" aria-labelledby="hero-title">
					<div class="hero-copy">
						<div class="eyebrow"><span class="eyebrow-icon">✦</span> CREATIVE PLAYER PROFILE <span class="eyebrow-line"></span> v. 2026</div>
						<h1 id="hero-title">I make the web<br /><span class="pink-text">feel like a game.</span></h1>
						<p class="typing-line"><span class="prompt">&gt;</span> <span id="typed-text">designer, developer, dreamer</span><span class="caret">▋</span></p>
						<p class="hero-intro">Hi, I'm Nina — a creative mind turning interfaces, ideas and pixels into experiences people want to stay in.</p>
						<div class="hero-actions">
							<a class="pixel-button primary" href="#projects"><span>PLAY MY WORK</span><span class="button-arrow">↗</span></a>
							<a class="pixel-button ghost" href="#about"><span>MEET THE PLAYER</span><span class="button-arrow">↓</span></a>
						</div>
						<div class="hero-stats" aria-label="Quick profile stats">
							<div><strong>03+</strong><span>years<br />creating</span></div>
							<div><strong>24</strong><span>side<br />quests</span></div>
							<div><strong>∞</strong><span>curiosity<br />points</span></div>
						</div>
					</div>
					<div class="hero-visual">
						<div class="orbit orbit-one"></div>
						<div class="orbit orbit-two"></div>
						<div class="portrait-frame">
							<div class="portrait-label">PLAYER PHOTO <span>● ONLINE</span></div>
							<div class="portrait-wrap">
								<div class="portrait-fallback">N<span>✦</span></div>
														<img src="/IMG_7441.png" alt="Nina smiling" onerror="this.style.display='none'" />
							</div>
							<div class="portrait-footer"><span>NINA.B</span><span>HP 100/100</span></div>
						</div>
						<div class="level-badge"><span>LVL</span><strong>08</strong><em>CREATIVE<br />MAGE</em></div>
						<img class="pixel-deco deco-laptop" src="/1.png" alt="" aria-hidden="true" />
						<img class="pixel-deco deco-heart" src="/12.png" alt="" aria-hidden="true" />
						<img class="pixel-deco deco-spark" src="/6.png" alt="" aria-hidden="true" />
					</div>
				</section>

				<div class="wave-marquee" aria-label="Pixel parade" aria-hidden="true"><div class="wave-track">{[...waveItems, ...waveItems].map((item, index) => <span class={`wave-item ${item.size}`} style={`--wave-tilt: ${item.tilt}deg; --wave-scale: ${item.scale};`} data-wave-index={index} data-mobile-hide={item.mobileHide ? 'true' : undefined}><img src={item.src} alt={item.alt} /></span>)}</div></div>

				<section class="section intro-section" id="about" aria-labelledby="about-title">
					<div class="section-heading"><span class="section-index">01</span><span class="section-kicker">PLAYER PROFILE</span><span class="heading-line"></span></div>
					<div class="intro-layout">
						<div><h2 id="about-title" class="section-title profile-title">A little bit<br /><span class="pink-text">soft. A lot<br />determined.</span></h2></div>
						<div class="intro-note"><div class="note-pin">✦</div><p>I believe the best digital experiences are equal parts useful, surprising and unmistakably human.</p><span class="note-signature">— a note from the player</span></div>
						<div class="intro-copy"><p>I'm a multidisciplinary creative who loves bringing structure to big ideas and sparkle to the small details. I work across visual design, front-end development and creative direction.</p><p>My favorite projects live somewhere between a polished product and a tiny world you want to explore.</p><a class="text-link" href="#contact">LET'S MAKE SOMETHING CUTE <span>→</span></a></div>
					</div>
				</section>

				<section class="section" id="experiences" aria-labelledby="journey-title">
					<div class="section-heading"><span class="section-index">02</span><span class="section-kicker">SAVE FILE // JOURNEY</span><span class="heading-line"></span></div>
					<div class="section-title-row"><h2 id="journey-title" class="section-title journey-title">My player <span class="pink-text">journey</span></h2><span class="section-caption">XP GAINED THROUGH CURIOSITY</span></div>
					<div class="journey-grid">
						<div class="timeline">
							<div class="timeline-item current"><span class="timeline-dot"></span><span class="timeline-year">2024 — NOW</span><div><h3>Creative Designer & Front-end Developer</h3><p>Making thoughtful, expressive digital experiences from first sketch to final pixel.</p><span class="mini-tag">MAIN QUEST</span></div></div>
							<div class="timeline-item"><span class="timeline-dot"></span><span class="timeline-year">2022 — 2024</span><div><h3>Visual Designer</h3><p>Building identities, campaigns and interfaces with a detail-obsessed little team.</p><span class="mini-tag">CO-OP MODE</span></div></div>
							<div class="timeline-item"><span class="timeline-dot"></span><span class="timeline-year">2020 — 2022</span><div><h3>Design Student</h3><p>Learning to turn “what if?” into a visual language people can feel.</p><span class="mini-tag">ORIGIN STORY</span></div></div>
						</div>
						<div class="education-card pixel-card" id="formation"><div class="card-top"><span>EDUCATION</span><span>ITEM 001</span></div><img src="/3.png" alt="Pixel art book" /><div><h3>Design & Digital Media</h3><p>Graduated with a soft spot for typography, interaction and storytelling.</p></div><div class="card-bar"><span></span></div><small>KNOWLEDGE METER: 87%</small></div>
					</div>
				</section>

				<section class="section" id="skills" aria-labelledby="skills-title">
					<div class="section-heading"><span class="section-index">03</span><span class="section-kicker">INVENTORY // LOADOUT</span><span class="heading-line"></span></div>
					<div class="section-title-row"><h2 id="skills-title" class="section-title inventory-title">Tools in my <span class="pink-text">inventory</span></h2><span class="section-caption">EQUIPPED & READY</span></div>
					<div class="skills-layout"><div class="tool-marquee-panel">{toolGroups.map((group) => <div class="tool-group"><div class="tool-group-label"><span>{group.label}</span><b>///</b></div><div class={`tool-marquee ${group.direction}`}><div class="tool-track">{[...group.items, ...group.items, ...group.items, ...group.items].map((tool) => <div class="tool-chip"><span class={`tool-logo ${tool.tone}`}>{tool.mark}</span><span>{tool.name}</span></div>)}</div></div></div>)}</div><div class="skill-card"><div class="skill-card-header"><span>SKILL TREE</span><span class="blink">● LIVE</span></div><div class="skill-ring"><span>DESIGN<br /><strong>+CODE</strong></span></div><p>Curious by default.<br />Always learning.</p><img src="/14.png" alt="" aria-hidden="true" /></div></div>
					<div class="languages-block"><div class="languages-heading"><span>LANGUAGE PACK</span><span>4 SLOTS READY</span></div><div class="language-grid">{languages.map((language) => <div class="language-card"><div class="language-top"><span>{language.number}</span><span>XP</span></div><h3>{language.name}</h3><div class="language-meter"><span style={`width: ${language.fill}`}></span></div><div class="language-bottom"><span>{language.level}</span><b>{language.fill}</b></div></div>)}</div></div>
				</section>

				<section class="section courses-section" id="courses" aria-labelledby="courses-title">
					<div class="section-heading"><span class="section-index">04</span><span class="section-kicker">UNLOCKED ACHIEVEMENTS</span><span class="heading-line"></span></div>
					<div class="section-title-row"><h2 id="courses-title" class="section-title xp-title">Tiny wins, <span class="pink-text">big XP</span></h2><span class="section-caption">CERTIFICATE COLLECTION</span></div>
					<div class="achievement-grid"><div class="achievement"><span class="achievement-icon">✦</span><div><small>ACHIEVEMENT UNLOCKED</small><h3>Front-end Foundations</h3><p>Responsive interfaces · 2024</p></div><span class="check">✓</span></div><div class="achievement"><span class="achievement-icon">♡</span><div><small>ACHIEVEMENT UNLOCKED</small><h3>Design Systems 101</h3><p>Scalable visual language · 2023</p></div><span class="check">✓</span></div><div class="achievement"><span class="achievement-icon">✧</span><div><small>ACHIEVEMENT UNLOCKED</small><h3>Creative Coding Lab</h3><p>Motion & interaction · 2023</p></div><span class="check">✓</span></div></div>
				</section>

				<section class="section projects-section" id="projects" aria-labelledby="projects-title">
					<div class="section-heading"><span class="section-index">05</span><span class="section-kicker">QUEST LOG // SELECTED WORK</span><span class="heading-line"></span></div>
					<div class="section-title-row"><h2 id="projects-title" class="section-title projects-title"><span class="projects-title-main">Things I've</span> <span class="pink-text">made</span></h2><span class="section-caption">CLICK TO INSPECT</span></div>
					<div class="project-grid">{projects.map((project) => <article class="project-card"><div class="project-image"><span class="project-number">{project.number}</span><div class="project-placeholder" aria-label={`Screenshot slot for ${project.title}`}><span class="placeholder-icon" aria-hidden="true">▧</span><span class="placeholder-label">SCREENSHOT SLOT</span><span class="placeholder-note">ADD IMAGE LATER</span></div><span class="inspect">INSPECT ↗</span></div><div class="project-info"><span class="project-type">{project.type}</span><h3>{project.title}</h3><p>{project.text}</p><div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></div></article>)}</div>
				</section>

				<section class="section contact-section" id="contact" aria-labelledby="contact-title">
					<div class="contact-box"><div class="section-heading"><span class="section-index">06</span><span class="section-kicker">OPEN INVITE // CONTACT</span><span class="heading-line"></span></div><h2 id="contact-title" class="section-title contact-title">Have a quest<br /><span class="pink-text">for me?</span></h2><p class="contact-intro"><span class="contact-prompt">&gt;</span> <span id="contact-typed-text">Tell me what you're building, dreaming or getting stuck on.</span><span class="contact-caret" aria-hidden="true">▋</span></p><a class="pixel-button primary contact-button" href="mailto:hello@nina.design"><span>SEND A MESSAGE</span><span class="button-arrow">↗</span></a><div class="contact-grid">{contactLinks.map((link) => <a class="contact-link-card" href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}><span class={`contact-link-icon ${link.tone}`}>{link.icon}</span><span><strong>{link.label}</strong><small>{link.detail}</small></span><b>↗</b></a>)}</div><div class="contact-links"><a href="mailto:hello@nina.design">hello@nina.design</a><span>·</span><a href="#top">back to top ↑</a></div></div>
				</section>
			</main>

			<footer><span>© 2026 NINA.B — MADE WITH ✦ & TOO MUCH COFFEE</span><span>PLAYER STATUS: <b>ONLINE</b></span></footer>
		</div>

		<script>
			const typed = document.querySelector('#typed-text');
			const phrases = ['designer, developer, dreamer', 'pixel perfectionist', 'your next creative co-op'];
			let phraseIndex = 0;
			let charIndex = phrases[0].length;
			let deleting = true;
			function typeLoop() {
				if (!typed) return;
				const phrase = phrases[phraseIndex];
				if (deleting) {
					charIndex -= 1;
					if (charIndex <= 0) { deleting = false; phraseIndex = (phraseIndex + 1) % phrases.length; }
				} else {
					charIndex += 1;
					if (charIndex >= phrase.length) { deleting = true; }
				}
				typed.textContent = phrases[phraseIndex].slice(0, charIndex);
				setTimeout(typeLoop, deleting ? 65 : 105);
			}
			setTimeout(typeLoop, 2500);

			const contactTyped = document.querySelector('#contact-typed-text');
			const contactPhrases = [
				"Tell me what you're building, dreaming or getting stuck on.",
				"I'm always down to talk ideas.",
			];
			let contactPhraseIndex = 0;
			let contactCharIndex = contactPhrases[0].length;
			let contactDeleting = true;
			function contactTypeLoop() {
				if (!contactTyped) return;
				const phrase = contactPhrases[contactPhraseIndex];
				if (contactDeleting) {
					contactCharIndex -= 1;
					if (contactCharIndex <= 0) { contactDeleting = false; contactPhraseIndex = (contactPhraseIndex + 1) % contactPhrases.length; }
				} else {
					contactCharIndex += 1;
					if (contactCharIndex >= phrase.length) { contactDeleting = true; }
				}
				contactTyped.textContent = contactPhrases[contactPhraseIndex].slice(0, contactCharIndex);
				setTimeout(contactTypeLoop, contactDeleting ? 65 : 105);
			}
			setTimeout(contactTypeLoop, 2500);

			const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) entry.target.classList.add('is-visible'); }), { threshold: 0.12 });
			document.querySelectorAll('.section, .project-card, .achievement, .timeline-item').forEach((element) => observer.observe(element));

			const topbar = document.querySelector('.topbar');
			const menuToggle = document.querySelector('.menu-toggle');
			const mainNav = document.querySelector('#main-nav');
			if (topbar && menuToggle && mainNav) {
				menuToggle.addEventListener('click', () => {
					const isOpen = topbar.classList.toggle('nav-open');
					menuToggle.setAttribute('aria-expanded', String(isOpen));
				});
				mainNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
					topbar.classList.remove('nav-open');
					menuToggle.setAttribute('aria-expanded', 'false');
				}));
			}

			const wave = document.querySelector('.wave-marquee');
			const isMobileWave = window.matchMedia('(max-width: 980px)').matches || window.matchMedia('(hover: none) and (pointer: coarse)').matches;
			const usePhoneWaveSpacing = window.matchMedia('(max-width: 620px)').matches;
			const movingWaveItems = [...document.querySelectorAll('.wave-item')].filter((item, index) => !isMobileWave || (item.dataset.mobileHide !== 'true' && index % 4 !== 3));
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const waveDuration = 30000;
			const wavePoints = isMobileWave
				? [[0, .52], [.24, .08], [.6, .9], [.82, .1], [1, .52]]
				: [[0, .52], [.24, .08], [.5, .9], [.76, .1], [1, .52]];

			function cubic(start, controlOne, controlTwo, end, progress) {
				const inverse = 1 - progress;
				return inverse ** 3 * start + 3 * inverse ** 2 * progress * controlOne + 3 * inverse * progress ** 2 * controlTwo + progress ** 3 * end;
			}

			function waveHeightAt(progress) {
				for (let index = 0; index < wavePoints.length - 1; index += 1) {
					const [startX, startY] = wavePoints[index];
					const [endX, endY] = wavePoints[index + 1];
					if (progress <= endX) {
						const localProgress = (progress - startX) / (endX - startX);
						return cubic(startY, startY, endY, endY, localProgress);
					}
				}
				return wavePoints.at(-1)[1];
			}

			function buildWaveArcMap(width, height) {
				const samples = 160;
				const travel = width + 260;
				const progresses = [0];
				const distances = [0];
				let total = 0;
				let previousX = -130;
				let previousY = 30 + waveHeightAt(0) * (height - 60);

				for (let index = 1; index <= samples; index += 1) {
					const progress = index / samples;
					const x = -130 + progress * travel;
					const y = 30 + waveHeightAt(progress) * (height - 60);
					total += Math.hypot(x - previousX, y - previousY);
					progresses.push(progress);
					distances.push(total);
					previousX = x;
					previousY = y;
				}

				return { progresses, distances, total };
			}

			function progressAtArcDistance(distanceRatio, arcMap) {
				const target = distanceRatio * arcMap.total;
				let index = 1;
				while (index < arcMap.distances.length && arcMap.distances[index] < target) index += 1;
				const previousDistance = arcMap.distances[index - 1];
				const segmentDistance = arcMap.distances[index] - previousDistance;
				const segmentProgress = segmentDistance ? (target - previousDistance) / segmentDistance : 0;
				return arcMap.progresses[index - 1] + (arcMap.progresses[index] - arcMap.progresses[index - 1]) * segmentProgress;
			}

			if (wave && movingWaveItems.length) {
				let waveArcMap;
				let waveArcMapKey = '';
				const renderWave = (timestamp) => {
					const width = wave.clientWidth;
					const height = wave.clientHeight;
					const elapsed = timestamp % waveDuration;
					const travel = width + 260;
					const currentWaveArcMapKey = `${width}:${height}`;
					if (usePhoneWaveSpacing && currentWaveArcMapKey !== waveArcMapKey) {
						waveArcMap = buildWaveArcMap(width, height);
						waveArcMapKey = currentWaveArcMapKey;
					}

					movingWaveItems.forEach((item, index) => {
						const phase = (elapsed / waveDuration + index / movingWaveItems.length) % 1;
						const progress = usePhoneWaveSpacing ? progressAtArcDistance(phase, waveArcMap) : phase;
						const nextProgress = (progress + .01) % 1;
						const currentY = waveHeightAt(progress);
						const nextY = waveHeightAt(nextProgress);
						const curveAngle = Math.max(-24, Math.min(24, Math.atan2((nextY - currentY) * height, travel * .01) * 180 / Math.PI));
						const x = -130 + progress * travel;
						const y = 30 + currentY * (height - 60);
						item.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) rotate(${curveAngle + Number.parseFloat(getComputedStyle(item).getPropertyValue('--wave-tilt'))}deg) scale(var(--wave-scale))`;
					});

					if (!reducedMotion) requestAnimationFrame(renderWave);
				};
				renderWave(0);
			}
		</script>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap');
	:global(*) { box-sizing: border-box; }
